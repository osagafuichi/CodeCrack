<UserControl x:Class="CodeCrackApp.Panels.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBox x:Name="QueryBox" Grid.Row="0" Grid.Column="0" Margin="0,0,6,4"
                 Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 KeyDown="OnQueryKeyDown"
                 AutomationProperties.AutomationId="SearchQuery"/>
        <Button Grid.Row="0" Grid.Column="1" Content="Find in Files" MinWidth="96" Margin="0,0,0,4"
                Click="OnFind" AutomationProperties.AutomationId="SearchFind"/>

        <TextBox Grid.Row="1" Grid.Column="0" Margin="0,0,6,4"
                 Text="{Binding Replacement, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.AutomationId="SearchReplacement"/>
        <Button Grid.Row="1" Grid.Column="1" Content="Replace All" MinWidth="96" Margin="0,0,0,4"
                Click="OnReplaceAll" AutomationProperties.AutomationId="SearchReplaceAll"/>

        <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,4" Opacity="0.8"
                   Text="{Binding Status}" AutomationProperties.AutomationId="SearchStatus"/>

        <ListBox Grid.Row="3" Grid.ColumnSpan="2"
                 ItemsSource="{Binding Results}"
                 SelectedItem="{Binding SelectedHit, Mode=TwoWay}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.AutomationId="SearchResults">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,2">
                        <TextBlock Text="{Binding Preview}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Opacity="0.6" FontSize="11" TextTrimming="CharacterEllipsis">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0}:{1}">
                                    <Binding Path="Path"/>
                                    <Binding Path="Line"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
