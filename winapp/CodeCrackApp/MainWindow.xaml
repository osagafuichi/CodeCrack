<Window x:Class="CodeCrackApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CodeCrackApp"
        Title="CodeCrack" Height="720" Width="1100"
        SourceInitialized="OnWindowSourceInitialized"
        Activated="OnWindowActivated"
        LocationChanged="OnLocationChanged" SizeChanged="OnWindowSizeChanged">
    <Window.CommandBindings>
        <CommandBinding Command="Open"   Executed="OnOpen"/>
        <CommandBinding Command="New"    Executed="OnNew"/>
        <CommandBinding Command="Save"   Executed="OnSave"     CanExecute="OnCanSave"/>
        <CommandBinding Command="SaveAs" Executed="OnSaveAs"   CanExecute="OnCanSave"/>
        <CommandBinding Command="Close"  Executed="OnCloseTab" CanExecute="OnCanSave"/>
        <CommandBinding Command="Find"   Executed="OnFind"/>
        <CommandBinding Command="{x:Static local:Commands.Run}"     Executed="OnRun"     CanExecute="OnCanRun"/>
        <CommandBinding Command="{x:Static local:Commands.Analyze}" Executed="OnAnalyze" CanExecute="OnCanAnalyze"/>
        <CommandBinding Command="{x:Static local:Commands.CancelAnalyze}" Executed="OnCancelAnalyze" CanExecute="OnCanCancelAnalyze"/>
        <CommandBinding Command="{x:Static local:Commands.Preferences}" Executed="OnPreferences"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl"       Command="Open"/>
        <KeyBinding Key="N" Modifiers="Ctrl"       Command="New"/>
        <KeyBinding Key="S" Modifiers="Ctrl"       Command="Save"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="SaveAs"/>
        <KeyBinding Key="W" Modifiers="Ctrl"       Command="Close"/>
        <KeyBinding Key="F" Modifiers="Ctrl"       Command="Find"/>
        <KeyBinding Key="R" Modifiers="Ctrl"       Command="{x:Static local:Commands.Run}"/>
        <KeyBinding Key="B" Modifiers="Ctrl"       Command="{x:Static local:Commands.Analyze}"/>
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{x:Static local:Commands.Preferences}"/>
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open…"     Command="Open"/>
                <MenuItem Header="_New"       Command="New"/>
                <MenuItem x:Name="OpenRecentMenu" Header="Open _Recent"/>
                <Separator/>
                <MenuItem Header="_Save"      Command="Save"/>
                <MenuItem Header="Save _As…"  Command="SaveAs"/>
                <MenuItem Header="_Close Tab" Command="Close"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Find…"     Command="Find"/>
                <Separator/>
                <MenuItem Header="_Preferences…" Command="{x:Static local:Commands.Preferences}"
                          InputGestureText="Ctrl+,"/>
            </MenuItem>
            <MenuItem Header="_Run">
                <MenuItem Header="_Run"       Command="{x:Static local:Commands.Run}"/>
                <MenuItem Header="_Analyze"   Command="{x:Static local:Commands.Analyze}"/>
                <MenuItem Header="Cancel A_nalyze" Command="{x:Static local:Commands.CancelAnalyze}"/>
            </MenuItem>
        </Menu>
        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Padding="6,3"
                   TextTrimming="CharacterEllipsis" Text="Open a file or folder to begin"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="0"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ContentControl x:Name="FileTreeHost" Grid.Column="0"/>
            <!-- Zero-width splitter: draggable but invisible (SplitDividerHider analog). -->
            <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Center"
                          Background="Transparent" ShowsPreview="False"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="240" MinHeight="0"/>
                </Grid.RowDefinitions>
                <!-- Tab strip: headers only; the editor below is a single reused control. -->
                <ListBox x:Name="TabStrip" Grid.Row="0" BorderThickness="0" Padding="0"
                         ItemsSource="{Binding Documents}"
                         SelectedItem="{Binding Active, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,0">
                                <TextBlock Text="&#9679;" Margin="0,0,4,0" VerticalAlignment="Center"
                                           Foreground="#C060A0FF">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDirty}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                <Button Content="&#10005;" Margin="6,0,0,0" Padding="3,0" FontSize="10"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Close Tab" Tag="{Binding}" Click="OnTabClose"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ContentControl x:Name="EditorHostSurface" Grid.Row="1"/>
                <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch"
                              Background="#22000000" ShowsPreview="False"/>
                <TabControl Grid.Row="3">
                    <TabItem Header="Issues"><ContentControl x:Name="IssuesHost"/></TabItem>
                    <TabItem Header="Tests"><ContentControl x:Name="TestsHost"/></TabItem>
                    <TabItem Header="Console"><ContentControl x:Name="ConsoleHost"/></TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
