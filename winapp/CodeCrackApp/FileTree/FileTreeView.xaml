<UserControl x:Class="CodeCrackApp.FileTree.FileTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CodeCrack.App.Core.ViewModels;assembly=CodeCrack.App.Core">
    <TreeView ItemsSource="{Binding Root.Children}" BorderThickness="0">
        <TreeView.Resources>
            <HierarchicalDataTemplate DataType="{x:Type vm:FileNode}" ItemsSource="{Binding Children}">
                <TextBlock Text="{Binding Name}"/>
            </HierarchicalDataTemplate>
        </TreeView.Resources>
    </TreeView>
</UserControl>
